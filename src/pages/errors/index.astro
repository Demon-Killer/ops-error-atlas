---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import SearchBox from '../../components/SearchBox.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('errors')).sort(
	(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const categories = [
	{
		title: 'Nginx and reverse proxy',
		description: 'Gateway errors, upstream timeouts, connection closes, and proxy routing failures.',
		tags: ['Nginx', 'reverse-proxy'],
	},
	{
		title: 'TCP and sockets',
		description: 'Resets, refused connections, broken pipes, retransmissions, and packet loss.',
		tags: ['TCP', 'sockets'],
	},
	{
		title: 'TLS and certificates',
		description: 'Handshake failures, unknown authorities, verification errors, and trust-store issues.',
		tags: ['TLS', 'certificates'],
	},
	{
		title: 'Linux operations',
		description: 'Host-level limits, DNS failures, ports, routes, and runtime diagnostics.',
		tags: ['Linux', 'DNS'],
	},
];
const searchItems = entries.map((entry) => ({
	title: entry.data.title,
	href: `/errors/${entry.data.slug}/`,
}));
---

<BaseLayout
	title="Error Guides | Ops Error Atlas"
	description="Browse focused guides for backend, Linux, TCP, Nginx, TLS, and timeout errors."
>
	<section class="page-hero section-inner">
		<h1 class="page-title">Error Guides</h1>
		<p class="page-intro">
			Each page explains one concrete backend or network error, the common causes behind it,
			and the first commands worth running.
		</p>
	</section>

	<section class="section section-inner">
		<SearchBox items={searchItems} />
	</section>

	<section class="section section-inner">
		<div class="section-heading">
			<div>
				<h2>Browse by failure area</h2>
				<p>Start from the layer that owns the symptom, then move to adjacent causes.</p>
			</div>
		</div>
		<div class="grid">
			{
				categories.map((category) => {
					const matches = entries
						.filter((entry) => entry.data.tags.some((tag) => category.tags.includes(tag)))
						.slice(0, 4);
					return (
						<section class="card">
							<div class="card-meta">
								<span>{category.tags.join(' / ')}</span>
							</div>
							<h3>{category.title}</h3>
							<p>{category.description}</p>
							<ul class="cluster-list">
								{matches.map((entry) => (
									<li>
										<a href={`/errors/${entry.data.slug}/`}>{entry.data.title}</a>
									</li>
								))}
							</ul>
						</section>
					);
				})
			}
		</div>
	</section>

	<section class="section section-inner">
		<div class="grid">
			{
				entries.map((entry) => (
					<ArticleCard
						title={entry.data.title}
						description={entry.data.description}
						href={`/errors/${entry.data.slug}/`}
						meta={entry.data.publishedAt.toLocaleDateString('en-US', {
							month: 'short',
							day: 'numeric',
							year: 'numeric',
						})}
						tags={entry.data.tags}
					/>
				))
			}
		</div>
	</section>
</BaseLayout>
