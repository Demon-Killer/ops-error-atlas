---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import SearchBox from '../components/SearchBox.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = (await getCollection('errors')).sort(
	(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const deepDiveSlugs = [
	'nginx-504-gateway-timeout',
	'upstream-prematurely-closed-connection',
	'x509-certificate-signed-by-unknown-authority',
];
const deepDiveEntries = deepDiveSlugs
	.map((slug) => entries.find((entry) => entry.data.slug === slug))
	.filter(Boolean);
const popular = entries
	.filter((entry) => entry.data.popular && !deepDiveSlugs.includes(entry.data.slug))
	.slice(0, 3);
const latest = entries.slice(0, 6);
const diagnosticPaths = [
	{
		title: 'Connection setup fails',
		description:
			'Use these when the client cannot establish a stable TCP connection to the target.',
		slugs: ['connect-timed-out', 'connection-refused', 'no-route-to-host'],
	},
	{
		title: 'Connection closes early',
		description:
			'Use these when a request starts but a peer, proxy, or application closes the socket.',
		slugs: ['connection-reset-by-peer', 'broken-pipe', 'socket-hang-up'],
	},
	{
		title: 'Proxy and upstream failures',
		description:
			'Use these when Nginx reaches the request path but the upstream exchange fails.',
		slugs: [
			'nginx-502-bad-gateway',
			'upstream-prematurely-closed-connection',
			'nginx-upstream-sent-too-big-header',
		],
	},
];
const topicClusters = [
	{
		title: 'Nginx upstream failures',
		description: 'Debug 502, 504, upstream timeouts, early closes, and client aborts.',
		slugs: [
			'nginx-504-gateway-timeout',
			'nginx-upstream-timed-out',
			'upstream-prematurely-closed-connection',
			'nginx-502-bad-gateway',
		],
	},
	{
		title: 'TCP connection failures',
		description: 'Separate resets, refused connections, broken pipes, packet loss, and latency.',
		slugs: [
			'connection-reset-by-peer',
			'connection-refused',
			'broken-pipe',
			'tcp-retransmissions',
		],
	},
	{
		title: 'TLS and certificate failures',
		description: 'Check unknown authorities, failed verification, handshake timeouts, and SNI issues.',
		slugs: [
			'x509-certificate-signed-by-unknown-authority',
			'tls-certificate-verify-failed',
			'tls-handshake-failure',
			'tls-handshake-timeout',
		],
	},
];
const searchItems = entries.map((entry) => ({
	title: entry.data.title,
	href: `/errors/${entry.data.slug}/`,
}));
---

<BaseLayout
	title="Ops Error Atlas | Explain backend and network errors in plain English"
	description="Ops Error Atlas helps engineers understand Linux, TCP, Nginx, cURL, TLS, and timeout errors faster."
>
	<section class="hero section-inner">
		<div class="hero-panel">
			<div class="hero-copy">
				<div class="tag-row">
					<span class="tag">Linux</span>
					<span class="tag">TCP</span>
					<span class="tag">Nginx</span>
					<span class="tag">TLS</span>
					<span class="tag">Timeouts</span>
				</div>
				<h1>Explain backend and network errors in plain English</h1>
				<p>
					Ops Error Atlas turns common production errors into concise guides with probable
					causes, diagnosis steps, and shell commands worth trying first.
				</p>
				<div class="button-row">
					<a class="button button-primary" href="/errors/">Browse Common Errors</a>
					<a class="button button-secondary" href="/tool/">Try Error Explainer</a>
				</div>
				<div class="hero-highlights">
					<span class="stat-chip">One page per error</span>
					<span class="stat-chip">Evidence-first diagnosis</span>
					<span class="stat-chip">Shell commands included</span>
				</div>
			</div>
			<div class="hero-aside">
				<ul class="metrics-grid">
					<li>
						<strong>{entries.length}</strong>
						<span>Detailed error guides</span>
					</li>
					<li>
						<strong>5</strong>
						<span>Failure layers covered</span>
					</li>
					<li>
						<strong>0</strong>
						<span>Blind config changes recommended</span>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="section section-inner">
		<div class="section-heading">
			<div>
				<h2>Deep Troubleshooting Guides</h2>
				<p>Start with guides that include diagnosis flow, commands, and common traps.</p>
			</div>
			<a class="button button-secondary" href="/errors/">Browse all guides</a>
		</div>
		<div class="grid">
			{
				deepDiveEntries.map((entry) => (
					<ArticleCard
						title={entry.data.title}
						description={entry.data.description}
						href={`/errors/${entry.data.slug}/`}
						meta="Deep guide"
						tags={entry.data.tags}
					/>
				))
			}
		</div>
	</section>

	<section class="section section-inner">
		<div class="section-heading">
			<div>
				<h2>Popular Error Guides</h2>
				<p>Start with the production failures engineers search most often.</p>
			</div>
			<a class="button button-secondary" href="/errors/">See all guides</a>
		</div>
		<div class="grid">
			{
				popular.map((entry) => (
					<ArticleCard
						title={entry.data.title}
						description={entry.data.description}
						href={`/errors/${entry.data.slug}/`}
						meta="Popular guide"
						tags={entry.data.tags}
					/>
				))
			}
		</div>
	</section>

	<section class="section section-inner">
		<SearchBox items={searchItems} />
	</section>

	<section class="section section-inner">
		<div class="section-heading">
			<div>
				<h2>Start From The Failure Phase</h2>
				<p>Pick the branch that matches what failed before changing timeouts or configs.</p>
			</div>
		</div>
		<div class="grid">
			{
				diagnosticPaths.map((path) => (
					<section class="card">
						<div class="card-meta">
							<span>Diagnosis path</span>
						</div>
						<h3>{path.title}</h3>
						<p>{path.description}</p>
						<ul class="cluster-list">
							{path.slugs.map((slug) => {
								const entry = entries.find((candidate) => candidate.data.slug === slug);
								return entry ? (
									<li>
										<a href={`/errors/${entry.data.slug}/`}>{entry.data.title}</a>
									</li>
								) : null;
							})}
						</ul>
					</section>
				))
			}
		</div>
	</section>

	<section class="section section-inner">
		<div class="section-heading">
			<div>
				<h2>Troubleshooting Topics</h2>
				<p>Use these clusters when one error is only the first visible symptom.</p>
			</div>
		</div>
		<div class="grid">
			{
				topicClusters.map((cluster) => (
					<section class="card">
						<div class="card-meta">
							<span>Topic cluster</span>
						</div>
						<h3>{cluster.title}</h3>
						<p>{cluster.description}</p>
						<ul class="cluster-list">
							{cluster.slugs.map((slug) => {
								const entry = entries.find((candidate) => candidate.data.slug === slug);
								return entry ? (
									<li>
										<a href={`/errors/${entry.data.slug}/`}>{entry.data.title}</a>
									</li>
								) : null;
							})}
						</ul>
					</section>
				))
			}
		</div>
	</section>

	<section class="section section-inner">
		<div class="section-heading">
			<div>
				<h2>Latest Guides</h2>
				<p>Focused writeups that explain what the error means and what to try next.</p>
			</div>
		</div>
		<div class="grid">
			{
				latest.map((entry) => (
					<ArticleCard
						title={entry.data.title}
						description={entry.data.description}
						href={`/errors/${entry.data.slug}/`}
						meta={entry.data.publishedAt.toLocaleDateString('en-US', {
							month: 'short',
							day: 'numeric',
							year: 'numeric',
						})}
						tags={entry.data.tags}
					/>
				))
			}
		</div>
	</section>

	<section class="section section-inner">
		<div class="text-panel">
			<div class="section-heading">
				<div>
					<h2>How the guides are written</h2>
					<p>
						Every guide starts with a concrete production-style error string, then separates
						evidence from guesses: the failing layer, the command output to capture, the common
						traps, and the smallest safe fix.
					</p>
				</div>
				<a class="button button-secondary" href="/methodology/">Read the methodology</a>
			</div>
		</div>
	</section>

	<section class="section section-inner">
		<div class="text-panel">
			<div class="section-heading">
				<div>
					<h2>Updated as production patterns become clearer.</h2>
					<p>
						Ops Error Atlas prioritizes improving existing troubleshooting guides when a
						page needs stronger diagnosis flow, clearer commands, or better links to related
						failures.
					</p>
				</div>
				<a class="button button-secondary" href="/about/">Read about the site</a>
			</div>
		</div>
	</section>

	<section class="section section-inner">
		<div class="text-panel">
			<div class="section-heading">
				<div>
					<h2>Paste an error. Get the likely meaning and next steps.</h2>
					<p>
						Error Explainer uses a local ruleset for common backend, network, TLS, and
						timeout failures, so results stay narrow, fast, and inspectable.
					</p>
				</div>
				<a class="button button-primary" href="/tool/">Open the tool</a>
			</div>
		</div>
	</section>
</BaseLayout>
