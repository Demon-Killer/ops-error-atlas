---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contact | Ops Error Atlas"
	description="Reach Ops Error Atlas with corrections, feedback, and suggestions for future error guides."
>
	<section class="page-hero section-inner">
		<h1 class="page-title">Contact</h1>
		<p class="page-intro">
			Questions, corrections, or suggestions? Reach out at
			<a href="mailto:lidonson666@gmail.com">lidonson666@gmail.com</a>.
		</p>
	</section>
	<section class="section section-inner">
		<div class="text-panel rich-copy">
			<h2>What feedback helps most</h2>
			<ul>
				<li>Missing causes or misleading diagnosis steps</li>
				<li>Real-world variations of an error message</li>
				<li>Ideas for adjacent guides that should link together</li>
			</ul>
			<h2>Response expectations</h2>
			<p>
				Feedback is reviewed manually. Priority goes to technical corrections, unclear
				commands, missing edge cases, and suggestions that improve existing troubleshooting
				guides.
			</p>
		</div>
	</section>
</BaseLayout>
