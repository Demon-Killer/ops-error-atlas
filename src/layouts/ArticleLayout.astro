---
import BaseLayout from './BaseLayout.astro';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type Props = {
	title: string;
	description: string;
	publishedAt: Date;
	updatedAt?: Date;
	tags: string[];
	headings: Heading[];
};

const { title, description, publishedAt, updatedAt, tags, headings } = Astro.props as Props;
const site = Astro.site ?? new URL('https://ops-error-atlas.pages.dev');
const canonical = new URL(Astro.url.pathname, site).toString();
const publishedLabel = publishedAt.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
const updatedLabel = updatedAt?.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
const visibleHeadings = headings.filter((heading) => heading.depth <= 2);
const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: title,
	description,
	url: canonical,
	datePublished: publishedAt.toISOString(),
	dateModified: (updatedAt ?? publishedAt).toISOString(),
	author: {
		'@type': 'Organization',
		name: 'Ops Error Atlas',
	},
	publisher: {
		'@type': 'Organization',
		name: 'Ops Error Atlas',
	},
	keywords: tags.join(', '),
	mainEntityOfPage: canonical,
};
const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: new URL('/', site).toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Error Guides',
			item: new URL('/errors/', site).toString(),
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: title,
			item: canonical,
		},
	],
};
---

<BaseLayout title={`${title} | Ops Error Atlas`} description={description}>
	<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
	<section class="page-hero section-inner">
		<div class="article-hero">
			<div class="tag-row">
				{tags.map((tag) => <span class="tag">{tag}</span>)}
			</div>
			<h1>{title}</h1>
			<p>{description}</p>
			<div class="hero-highlights">
				<span class="note-chip">Published {publishedLabel}</span>
				{updatedLabel && <span class="note-chip">Updated {updatedLabel}</span>}
				<span class="note-chip">One error per page</span>
				<span class="note-chip">Commands included</span>
			</div>
		</div>
	</section>
	<section class="section-inner">
		<div class="article-shell">
			<article class="rich-copy">
				<slot />
			</article>
			<aside class="article-toc" aria-label="Table of contents">
				<div class="article-summary">
					<strong>On this page</strong>
					<span class="muted">Start with diagnosis before changing configs.</span>
				</div>
				<ul>
					{
						visibleHeadings.map((heading) => (
							<li>
								<a href={`#${heading.slug}`}>{heading.text}</a>
							</li>
						))
					}
				</ul>
			</aside>
		</div>
	</section>
</BaseLayout>
